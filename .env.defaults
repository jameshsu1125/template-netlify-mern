# mongodb
# mongodb uri
URI=mongodb://localhost:27017/
# mongodb database name
DATABASE=demo

# image storage type: cloudinary | bunnycdn (default: bunnycdn)
CLOUD_STORAGE_TYPE=cloudinary

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=


# BunnyCDN
BUNNY_PASSWORD=
BUNNY_STORAGE_ZONE=
BUNNY_FOLDER_NAME=
# region code, e.g. SG
BUNNY_REGION=SG

## administrator
AMIN_EMAIL=
