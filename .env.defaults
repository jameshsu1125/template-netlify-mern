# mongodb
# mongodb uri
URI=mongodb://localhost:27017/
# mongodb database name
DATABASE=demo

# image storage type: cloudinary | bunnycdn (default: bunnycdn)
CLOUD_STORAGE_TYPE=cloudinary

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=


# BunnyCDN
BUNNY_PASSWORD=
BUNNY_STORAGE_ZONE=
BUNNY_FOLDER_NAME=
# region code, e.g. SG
BUNNY_REGION=SG

## administrator
AMIN_EMAIL=

# Auth0 access token verification
# Auth0 tenant domain, without the protocol, e.g. your-tenant.us.auth0.com
AUTH0_DOMAIN=
# identifier of the Auth0 API the frontend requests a token for
AUTH0_AUDIENCE=
# namespace of the custom claims added by the post-login action
# (default: https://template-netlify-mern/)
AUTH0_CLAIMS_NAMESPACE=https://template-netlify-mern/
